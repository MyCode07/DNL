{
  "name": "DNL-Capital",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "test": "node --test \"build/tests/*.test.js\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4040",
    "sprite": "node build/scripts/sprite.js",
    "lint": "eslint src/js build vite.config.js playwright.config.js eslint.config.js",
    "format": "prettier --write src/js build .github/workflows vite.config.js playwright.config.js eslint.config.js package.json .prettierrc.json",
    "format:check": "prettier --check src/js build .github/workflows vite.config.js playwright.config.js eslint.config.js package.json .prettierrc.json",
    "check": "npm run lint && npm run format:check && npm test",
    "test:dev": "node --test \"build/tests/*.integration.js\"",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "browserslist": [
    "last 3 versions"
  ],
  "dependencies": {
    "@cornerkit/core": "^1.3.1",
    "gsap": "^3.12.7",
    "intl-tel-input": "^29.5.7",
    "lenis": "^1.3.26",
    "swiper": "^12.2.0"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.12.0",
    "fast-glob": "^3.3.3",
    "fonteditor-core": "^2.6.3",
    "globals": "^17.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "sass": "^1.93.2",
    "sharp": "^0.35.5",
    "svgo": "^4.0.0",
    "vite": "^8.3.6"
  }
}
