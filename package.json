{
  "name": "DNL-Capital",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "test": "node --test",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4040",
    "sprite": "node build/scripts/sprite.js",
    "lint": "eslint src/js build/tests/runtime.test.js",
    "format": "prettier --write src/js eslint.config.js .prettierrc.json build/tests/runtime.test.js",
    "format:check": "prettier --check src/js eslint.config.js .prettierrc.json build/tests/runtime.test.js",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "browserslist": [
    "last 3 versions"
  ],
  "dependencies": {
    "@fancyapps/ui": "^5.0.36",
    "gsap": "^3.12.7",
    "inputmask": "^5.0.9",
    "lenis": "^1.3.26",
    "matter-js": "^0.20.0",
    "smoothscroll-for-websites": "^1.5.1",
    "swiper": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.12.0",
    "fast-glob": "^3.3.3",
    "fonteditor-core": "^2.6.3",
    "globals": "^17.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "sass": "^1.93.2",
    "sharp": "^0.34.4",
    "svgo": "^4.0.0",
    "vite": "^8.3.1"
  }
}
