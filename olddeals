
.deals {
    background-color: $black;

    .section__top {
        margin-bottom: 0;

        h2 {
            @media (max-width:767px) {
                max-width: 90%;
            }
        }

        p {
            max-width: 60rem;

            @media (max-width:1440px) {
                max-width: 44rem;
            }
        }
    }

    .section__body {
        padding-bottom: 6rem;

        @media (max-width:1440px) {
            padding-bottom: 4rem;
        }
    }

    --deals-slide-width: 25%;
    --deals-gap: 2rem;
    --deals-duration: 800ms;
    --deals-ease: cubic-bezier(0.65, 0, 0.35, 1);

    @media (min-width:1921px) {}

    @media (max-width:1440px) {}

    @media (max-width:767px) {
        --deals-slide-width: 100%;
        --deals-gap: 1.6rem;
    }

    // .deals-controls
    &-controls {
        @media (768px <=width <=1024px) {
            z-index: 2;
            position: absolute;
            left: 0;
            bottom: 28rem;
            width: 100%;
        }

        @media (max-width:767px) {
            position: relative;
        }
    }

    // .deals-viewport
    &-viewport {
        padding-top: 0.2rem;
        touch-action: pan-y pinch-zoom;

        @media (max-width:1920px) {
            width: 100vw;
            padding-inline: 4rem;
            margin-left: -4rem;
        }

        @media (max-width:1440px) {
            padding-inline: 3rem;
            margin-left: -3rem;
        }

        @media (max-width:1024px) {
            padding-inline: 1.6rem;
            margin-left: -1.6rem;
        }
    }

    // .deals-track
    &-track {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--deals-gap);
        position: relative;
        transition: transform var(--deals-duration) var(--deals-ease);
    }

    .deals-track.is-measuring,
    .deals-track.is-measuring .deals-slide,
    .deals-track.is-measuring .deals-slide__layer,
    .deals-track.is-measuring .icon::before,
    .deals-track.is-measuring .icon::after {
        transition: none !important;
    }

    .swiper-progress {
        position: absolute;
        top: 1.55rem;
        left: 50%;
        width: 100vw;
        height: 0.1rem;
        transform: translateX(-50%);
        background: $white-20;
        pointer-events: none;

        @media (max-width:1024px) {
            top: 1.15rem;
        }

        .swiper-pagination-progressbar-fill {
            display: block;
            width: 100%;
            height: 100%;
            background: $white;
            transform-origin: left;
            transition: transform var(--deals-duration) var(--deals-ease);
            display: none;
        }
    }

    .swiper-navigation {
        z-index: 2;
        position: relative;
    }

    @media (prefers-reduced-motion: reduce) {
        --deals-duration: 0ms;

        .deals-slide * {
            transition: none !important;
        }
    }

    // .deals-slider
    &-slider {
        position: relative;
    }

    // .deals-slide
    // Both text layers keep their own typography during the reveal.
    &-slide {
        color: $white-60;
        width: var(--deals-slide-width);
        flex: 0 0 auto;
        min-width: 0;
        transition: left var(--deals-duration) var(--deals-ease);
        transform-origin: left;
        display: flex;
        flex-direction: column;
        cursor: pointer;
        height: 21rem;

        @media (min-width:1025px) {
            position: absolute;
            left: 0;
            top: 0;
        }

        @media (max-width:1440px) {
            height: 15rem;
        }

        @media (max-width:767px) {}

        .icon {
            position: relative;
            z-index: 1;
            flex: 0 0 auto;
            width: 2.7rem;
            height: 2.7rem;
            border-radius: 0.8rem;

            @media (max-width:1024px) {
                width: 1.9rem;
                height: 1.9rem;
            }

            &::before,
            &::after {
                content: '';
                position: absolute;
                left: 50%;
                top: 50%;
                transform: translate(-50%, -50%);
            }

            &::before {
                z-index: 1;
                width: 0.7rem;
                height: 0.7rem;
                border-radius: 0.2rem;
                background-color: $gray-300;
                transition: width var(--deals-duration) var(--deals-ease),
                    height var(--deals-duration) var(--deals-ease),
                    background-color var(--deals-duration) var(--deals-ease);

                @media (max-width:1024px) {
                    width: 0.5rem;
                    height: 0.5rem;
                    border-radius: 0.1rem;
                }
            }

            &::after {
                width: 100%;
                height: 100%;
                border: 0.2rem solid $white;
                border-radius: 0.8rem;
                background-color: $black;
                transform: translate(-50%, -50%) scale(0);
                opacity: 0;
                transition: transform var(--deals-duration) var(--deals-ease),
                    opacity var(--deals-duration) var(--deals-ease);

                @media (max-width:1024px) {
                    border-radius: 0.5rem;
                }
            }
        }

        // .deals-slide__content
        &__content {
            display: grid;
            padding-top: 3.8rem;

            @media (max-width:1440px) {
                padding-top: 3rem;
            }
        }

        // .deals-slide__layer
        &__layer {
            grid-area: 1 / 1;
            min-width: 0;
            transition: opacity 0.35s ease, transform 0.5s ease, filter 0.5s ease, visibility 0.5s;

            &--detail {
                opacity: 0;
                visibility: hidden;
                filter: blur(0.8rem);
                transform: translateY(1rem);
                pointer-events: none;
            }
        }

        // .deals-slide__head
        &__head {
            display: flex;
            align-items: flex-start;
            gap: 4rem;

            @media (max-width:1440px) {
                gap: 3rem;
            }

            @media (max-width:767px) {
                gap: 2rem;
            }

            span {
                flex: 0 0 2rem;
                margin-top: 0.3rem;
                text-align: right;

                @media (max-width:1440px) {
                    margin-top: 0.5rem;
                }

                @media (max-width:1024px) {
                    margin-top: 0.3rem;
                }
            }
        }

        h4,
        h3 {
            color: inherit;
        }

        // .deals-slide__layer--detail
        &__layer--detail {
            color: $white;

            p {
                color: $white-60;
                margin-top: 2.4rem;
                padding-left: 6rem;
                max-width: 42rem;
                padding-right: 2rem;

                @media (max-width:1440px) {
                    margin-top: 2em;
                    padding-left: 5rem;
                }

                @media (max-width:767px) {
                    padding-left: 4rem;
                    margin-top: 1.6rem;
                }
            }
        }

        @media (any-hover: hover) {
            &:not(.active) {
                .deals-slide__layer {
                    transition: opacity var(--deals-duration) var(--deals-ease),
                        transform var(--deals-duration) var(--deals-ease),
                        filter var(--deals-duration) var(--deals-ease),
                        visibility var(--deals-duration);
                }

                p {
                    display: none;
                }

                &:hover {
                    .deals-slide__layer--preview {
                        opacity: 0;
                        visibility: hidden;
                        pointer-events: none;
                    }

                    .deals-slide__layer--detail {
                        opacity: 1;
                        visibility: visible;
                        filter: blur(0);
                        transform: translateY(0);
                    }

                    .icon {
                        &::before {
                            width: 1.5rem;
                            height: 1.5rem;
                            background-color: $white;

                            @media (max-width:1024px) {
                                width: 1rem;
                                height: 1rem;
                                border-radius: 0.2rem;
                            }
                        }

                        &::after {
                            transform: translate(-50%, -50%) scale(1);
                            background-color: $black;
                            opacity: 1;
                        }
                    }
                }
            }
        }

        &.active {
            .icon {
                &::before {
                    width: 1.5rem;
                    height: 1.5rem;
                    background-color: $white;

                    @media (max-width:1024px) {
                        width: 1rem;
                        height: 1rem;
                        border-radius: 0.2rem;
                    }
                }

                &::after {
                    transform: translate(-50%, -50%) scale(1);
                    opacity: 1;
                    background-color: $black;
                }
            }

            .deals-slide__layer--preview {
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
            }

            .deals-slide__layer--detail {
                opacity: 1;
                visibility: visible;
                filter: blur(0);
                transform: translateY(0);
            }
        }
    }

    // .deals-collection
    &-collection {
        --reveal: 100%;

        @media (min-width:768px) {
            position: absolute;
            inset: 0;
            pointer-events: none;
            opacity: 1;
            pointer-events: none;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
        }

        @media (max-width:1440px) {}

        @media (max-width:1024px) {}

        &__wrap {
            // Keep animated image z-indices below the sibling controls.
            isolation: isolate;
            height: 100vh;
            // height: 100svh;
            min-height: 100vh;

            // min-height: 100svh;
            @media (max-width:1440px) {}

            @media (max-width:1024px) {
                margin-top: -5vh;
                // margin-top: -5svh;
            }

            @media (max-width:767px) {
                margin-top: 6rem;
                margin-bottom: 3rem;
                height: 40vw;
                min-height: auto;
                position: relative;
            }
        }
    }

    // .deals-media
    &-media {
        will-change: clip-path, transform;
        pointer-events: none;
        position: absolute;
        inset: 0;
        overflow: hidden;
        clip-path: inset(0 0 100% 0);

        .deals-collection:first-child & {
            clip-path: inset(0);
        }

        // .deals-media__inner
        &__inner {
            will-change: transform;
            transform-origin: 50%;
            pointer-events: none;
            position: absolute;
            inset: 0;

            img,
            picture {
                display: block;
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: top;

                @media (max-width:1024px) {
                    object-fit: contain;
                    object-position: center;
                }
            }

            img {
                @media (max-width:1024px) and (min-width: 768px) {
                    max-width: none;
                    width: calc(100% + 6rem);
                    margin-left: -3rem;
                }
            }
        }
    }

    @media (min-width:1025px) {
        --deals-navigation-gap: 6rem;
        --deals-slide-width: calc((100% - (var(--deals-count, 4) - 1) * var(--deals-gap)) / var(--deals-count, 4));

        .section__body {
            min-height: 100svh;
            display: flex;
            flex-direction: column;
        }

        .section__top {
            position: relative;
            z-index: 2;
            flex: 0 0 auto;

            p {
                position: absolute;
                top: calc(100% + 3rem);
                left: 0;
                width: 100%;
            }
        }

        .deals-slider {
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }

        .deals-collection__wrap {
            position: relative;
            flex: 1 1 auto;
            height: auto;
            min-height: 56rem;
        }

        .deals-media__inner img,
        .deals-media__inner picture {
            object-fit: contain;
        }

        .deals-media__inner img {
            // The shared artwork has empty space below the illustration.
            height: 160%;
        }

        .deals-controls {
            position: relative;
            bottom: auto;
            flex: 0 0 auto;
            display: grid;
            gap: var(--deals-navigation-gap);
        }

        .deals-viewport {
            height: calc(var(--deals-cards-height, 21rem) + 0.2rem);
        }

        .deals-track {
            height: 100%;
        }

        .deals-slide {
            left: calc(var(--slide) * (var(--deals-slide-width) + var(--deals-gap)));
            height: auto;
        }

        .deals-slide:not(.active) p {
            display: block;
            visibility: hidden;
        }

        .swiper-navigation {
            position: relative;
            bottom: auto;
            left: auto;
            transform: none;
            margin: 0 auto;
        }
    }

    @media (1024px < width <=1440px) {
        --deals-navigation-gap: 1.4rem;

        .deals-collection__wrap {
            min-height: 33rem;
            width: calc(100% - 44rem);
            align-self: flex-end;
        }
    }
}